# ================= QQ 伴侣机器人配置 =================
# 使用方式：把本文件复制为 .env，然后按下面的说明填写。
# .env 已在 .gitignore 里，不会被提交——里面是你的账号和 API Key。

# ---------- NapCat WebSocket ----------
# NapCat 的 OneBot v11 正向 WebSocket 地址。端口要和 NapCat「网络配置」里
# 建的那个一致（README 里用的是 3001）。
WS_URL=ws://127.0.0.1:3001

# ---------- 主人 ----------
# 你的 QQ 号（管理命令 / 定时提醒 / 私聊陪聊 只有这个号能用）
OWNER_QQ=100000000

# 机器人自己的 QQ 号（用于识别"被@了"；填 0 表示自动从事件里识别）
BOT_QQ=0

# ---------- AI 陪聊 ----------
# 可选 deepseek / anthropic
#   deepseek  = DeepSeek 官方接口，国内可直连（推荐，便宜）
#   anthropic = Anthropic Messages API 协议，也可以指向任何兼容端点
LLM_PROVIDER=deepseek

# DeepSeek（https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Anthropic（只有在 LLM_PROVIDER=anthropic 时才用；需要能访问 Anthropic 的网络）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
MODEL=claude-opus-5

# ---------- serious 通道（可选） ----------
# 「serious <问题>」开头的消息走这个通道，不带陪聊人设，适合问正经问题。
# 留空则复用上面的陪聊凭证。键名沿用 GROK_* 是历史原因，可以是任何
# Anthropic 兼容端点（默认复用 ANTHROPIC_*）。
ANTHROPIC_AUTH_TOKEN=
GROK_API_KEY=
GROK_BASE_URL=
GROK_MODEL=claude-opus-5
# serious 回复的首行标签，显示成 [标签]
SERIOUS_TAG=serious
# 除主人外，允许使用 serious 通道的 QQ 号（逗号分隔，留空=只有主人能用）
SERIOUS_ALLOWED=

# ---------- 机器人与人设 ----------
BOT_NAME=小助手

# 陪聊人设。不填则用 bot/config.py 里的 DEFAULT_PERSONA（中性、温和）。
# 想让它有性格就写在这里，例如：
# CHAT_PERSONA=你是小助手，说话活泼简短，偶尔用颜文字，回答一律用中文。
CHAT_PERSONA=

# 群聊触发方式：at_only=只在被@时回复；all=群里任何消息都回（慎用，会刷屏）
CHAT_MODE=at_only

# 记忆最近多少条对话作为上下文
MAX_HISTORY=12

# 连续对话冷却（秒），防刷屏
CHAT_COOLDOWN=3

# 单次回复的最大 token 数
# 注意：如果用推理模型（会先输出思考过程），这里太小会被思考吃光导致空回复，
# 建议不低于 1024。
CHAT_MAX_TOKENS=2048

# 思考深度（仅 anthropic 协议生效）：low / medium / high
CHAT_EFFORT=medium

# 除主人外，允许私聊陪聊的 QQ 号（逗号分隔）
CHAT_ALLOWED_PRIVATE=

# ---------- 每日早安 ----------
# 每天早上几点私聊问候主人（24小时制 HH:MM，留空关闭）
MORNING_GREET_TIME=09:00
# 额外问候的 QQ 号（逗号分隔，除主人外每天早上也问候这些人）
MORNING_GREET_TARGETS=

# ---------- 群管理 ----------
# 新人进群欢迎语
WELCOME_MSG=欢迎来到本群，一起愉快地玩耍吧～

# ---------- 文件桥接（可选） ----------
# 另一个程序的项目根目录。设置后，那个程序丢到
#   <MACRO_DIR>/output/alerts/*.md   的文件会逐条私聊推送给你
#   <MACRO_DIR>/output/reports/*.pdf 的文件会作为附件推送给你
# 留空 = 该插件不启用。
MACRO_DIR=

# ---------- 数据 ----------
# SQLite 数据库路径（相对本项目目录）
DB_PATH=data/qq.db
